{
	"name": "ROS2 Rust Devcontainer",
    "build": {
        "dockerfile": "../src/ros2_rust/Dockerfile",
		"context": "..",
		"args": {
			"ROS_DISTRO": "humble"
		}
    },
    "workspaceFolder": "/workspaces/ros2rs_workspace",
	"containerEnv": {
		/* Uncomment to allow the container to access the X server on the host e.g. to run Rviz and other GUI tools
    	"DISPLAY": "${localEnv:DISPLAY}"
		*/
    },
	"postCreateCommand": "./scripts/setup.sh",
    "customizations": {
        "vscode": {
            "settings": {},
            "extensions": [
				"mhutchie.git-graph",
				"rust-lang.rust-analyzer",
				"fill-labs.dependi"
			]
        }
    }
  }